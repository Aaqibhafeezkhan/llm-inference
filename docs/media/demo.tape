# Regenerate the README demo from the repo root:  vhs docs/media/demo.tape
Output docs/media/demo.gif

Require python3

Set Shell "bash"
Set Theme "GitHub Dark"
Set FontSize 15
Set Width 1240
Set Height 760
Set Padding 22
Set WindowBar Colorful
Set BorderRadius 10
Set TypingSpeed 35ms

Type "python3 serving/continuous_batching.py"
Sleep 300ms
Enter
Sleep 2.5s

Type "clear"
Enter
Sleep 300ms

Type "python3 check_all.py"
Sleep 300ms
Enter
Sleep 7s
